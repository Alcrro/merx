# Database
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth — generate with: openssl rand -base64 64
JWT_SECRET=

# Google OAuth — the API exchanges the code; redirect URI is ${WWW_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WWW_URL=http://localhost:3003

# AI
OPENAI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Billing webhook (/api/v1/webhooks/billing) has its own signing secret in Stripe; falls back to STRIPE_WEBHOOK_SECRET (local `stripe listen`)
# STRIPE_BILLING_WEBHOOK_SECRET=whsec_...
STRIPE_ORDERS_WEBHOOK_SECRET=whsec_...

# Feature flags
ORDER_V2_ENABLED=false
