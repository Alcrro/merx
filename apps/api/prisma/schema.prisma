generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ────────────────────────────────────────────────────────────────────

enum PlatformRole {
  admin
  user
}

enum StoreStatus {
  active
  suspended
  blocked
}

enum PlanStatus {
  trial
  active
  past_due
  cancelled
  expired
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  password         String?
  name             String?
  avatarUrl        String?      @map("avatar_url")
  preferredLocale  String       @default("ro") @map("preferred_locale")
  authProvider     String       @default("email") @map("auth_provider")
  googleId         String?      @unique @map("google_id")
  emailVerified    Boolean      @default(false) @map("email_verified")
  platformRole     PlatformRole @default(user) @map("platform_role")

  // Trial & subscription
  planStatus       PlanStatus   @default(trial) @map("plan_status")
  planId           String?      @map("plan_id")
  trialStartedAt   DateTime     @default(now()) @map("trial_started_at")
  trialEndsAt      DateTime     @default(dbgenerated("now() + interval '14 days'")) @map("trial_ends_at")
  stripeCustomerId String?      @unique @map("stripe_customer_id")

  // Data export
  lastDataExportAt DateTime?    @map("last_data_export_at")

  // SSO handoff
  ssoCode          String?      @map("sso_code")
  ssoCodeExpiresAt DateTime?    @map("sso_code_expires_at")

  // Soft delete
  deletedAt        DateTime?    @map("deleted_at")

  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  stores                 Store[]
  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  aiSessions             AISession[]
  intro                  UserIntro?

  @@map("users")
}

model UserIntro {
  id          String    @id @default(uuid())
  userId      String    @unique @map("user_id")
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_intros")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  userAgent String?  @map("user_agent")
  ip        String?  @map("ip")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// ─── STORE ───────────────────────────────────────────────────────────────────

model Store {
  id        String    @id @default(uuid())
  ownerId   String    @map("owner_id")
  name      String
  slug      String    @unique
  currency  String    @default("EUR")
  locale    String    @default("en")
  timezone  String    @default("Europe/Bucharest")
  settings                     Json      @default("{}")
  themePublishedId             String?   @map("theme_published_id")
  customDomain                 String?     @unique @map("custom_domain")
  customDomainStatus           String?     @map("custom_domain_status")
  canonicalHost                String?     @map("canonical_host")
  status                       StoreStatus @default(active)
  deletedAt                    DateTime?   @map("deleted_at")
  createdAt                    DateTime    @default(now()) @map("created_at")
  updatedAt                    DateTime    @updatedAt @map("updated_at")

  owner               User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  categories          ProductCategory[]
  brands              Brand[]
  tags                Tag[]
  products            Product[]
  customers           Customer[]
  orders              Order[]
  inventoryItems      InventoryItem[]
  inventoryMovements  InventoryMovement[]
  dailyStoreMetrics   DailyStoreMetrics[]
  dailyProductMetrics DailyProductMetrics[]
  aiSessions          AISession[]
  aiActions           AIAction[]
  aiInsights          AIInsight[]
  auditLogs           AuditLog[]
  discountCodes        DiscountCode[]
  storeProducts        StoreProduct[]
  productRequests      ProductRequest[]
  themeVersions        ThemeVersion[]
  notifications        Notification[]
  variantStocks        StoreVariantStock[]
  shippingMethods      ShippingMethod[]

  @@index([ownerId])
  @@index([status])
  @@map("stores")
}

// ─── PRODUCTS ────────────────────────────────────────────────────────────────

model ProductCategory {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  name      String
  slug      String
  parentId  String?  @map("parent_id")
  createdAt DateTime @default(now()) @map("created_at")

  store    Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@unique([storeId, slug])
  @@index([storeId, parentId])
  @@map("product_categories")
}

model Brand {
  id       String  @id @default(uuid())
  storeId  String  @map("store_id")
  name     String
  slug     String
  logoUrl  String? @map("logo_url")

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([storeId, slug])
  @@map("brands")
}

model Tag {
  id      String @id @default(uuid())
  storeId String @map("store_id")
  name    String
  slug    String
  type    String @default("custom")

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[] @relation("ProductTags")

  @@unique([storeId, slug])
  @@index([storeId, type])
  @@map("tags")
}

model Product {
  id                   String    @id @default(uuid())
  storeId              String    @map("store_id")
  categoryId           String?   @map("category_id")
  brandId              String?   @map("brand_id")
  title                String
  description          String?
  status               String    @default("draft")
  productType          String?   @map("product_type")
  metadata             Json      @default("{}")
  migratedToCatalogAt  DateTime? @map("migrated_to_catalog_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  store               Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category            ProductCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand               Brand?                @relation(fields: [brandId], references: [id], onDelete: SetNull)
  tags                Tag[]                 @relation("ProductTags")
  variants            ProductVariant[]
  images              ProductImage[]
  dailyProductMetrics DailyProductMetrics[]

  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, brandId])
  @@map("products")
}

model ProductVariant {
  id             String   @id @default(uuid())
  productId      String   @map("product_id")
  sku            String
  title          String
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2) @map("compare_at_price")
  cost           Decimal? @db.Decimal(10, 2)
  weight         Decimal? @db.Decimal(10, 3)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItem         InventoryItem?
  orderItems            OrderItem[]
  inventoryMovements    InventoryMovement[]
  inventoryReservations InventoryReservation[]

  @@unique([productId, sku])
  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  url       String
  altText   String?  @map("alt_text")
  position  Int      @default(0)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, isPrimary])
  @@map("product_images")
}

// ─── INVENTORY ───────────────────────────────────────────────────────────────

model InventoryItem {
  id               String   @id @default(uuid())
  variantId        String   @unique @map("variant_id")
  storeId          String   @map("store_id")
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  reorderPoint     Int      @default(0) @map("reorder_point")
  updatedAt        DateTime @updatedAt @map("updated_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("inventory_items")
}

model InventoryMovement {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  variantId String   @map("variant_id")
  type      String
  quantity  Int
  note      String?
  actorType String   @default("user") @map("actor_type")
  createdAt DateTime @default(now()) @map("created_at")

  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@map("inventory_movements")
}

// ─── CUSTOMERS & ORDERS ──────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  email     String
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([storeId, email])
  @@map("customers")
}

model Order {
  id                      String    @id @default(uuid())
  storeId                 String    @map("store_id")
  customerId              String?   @map("customer_id")
  orderNumber             Int       @default(autoincrement()) @map("order_number")
  status                  String    @default("ACTIVE")
  paymentStatus           String    @default("PENDING")      @map("payment_status")
  fulfillmentStatus       String    @default("UNFULFILLED")  @map("fulfillment_status")
  source                  String    @default("storefront")
  currency                String
  subtotal                Decimal   @db.Decimal(10, 2)
  discountTotal           Decimal   @default(0) @db.Decimal(10, 2) @map("discount_total")
  discountCodeId          String?   @map("discount_code_id")
  discountCodeSnapshot    String?   @map("discount_code_snapshot")
  taxTotal                Decimal   @default(0) @db.Decimal(10, 2) @map("tax_total")
  shippingTotal           Decimal   @default(0) @db.Decimal(10, 2) @map("shipping_total")
  total                   Decimal   @db.Decimal(10, 2)
  shippingAddress         Json?     @map("shipping_address")
  metadata                Json      @default("{}")
  stripePaymentIntentId   String?   @unique @map("stripe_payment_intent_id")
  stripeSessionId         String?   @map("stripe_session_id")
  paymentEventAt          DateTime? @map("payment_event_at")
  version                 Int       @default(0)
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  store               Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  discountCode        DiscountCode?        @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)
  events              OrderEvent[]
  inventoryReservation InventoryReservation?

  @@index([storeId])
  @@index([storeId, status])
  @@index([storeId, fulfillmentStatus])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String   @map("order_id")
  variantId       String?  @map("variant_id")
  title           String
  sku             String?
  quantity        Int
  unitPrice       Decimal  @db.Decimal(10, 2) @map("unit_price")
  total           Decimal  @db.Decimal(10, 2)
  productSnapshot Json?    @map("product_snapshot")

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

model InventoryReservation {
  id          String    @id @default(uuid())
  orderId     String    @unique @map("order_id")
  variantId   String?   @map("variant_id")
  quantity    Int
  expiresAt   DateTime  @map("expires_at")
  confirmedAt DateTime? @map("confirmed_at")
  releasedAt  DateTime? @map("released_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([variantId, expiresAt])
  @@map("inventory_reservations")
}

model ProcessedWebhook {
  stripeEventId String   @id @map("stripe_event_id")
  processedAt   DateTime @default(now()) @map("processed_at")

  @@map("processed_webhooks")
}

model OrderEvent {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  eventType String   @map("event_type")
  fromState String?  @map("from_state")
  toState   String?  @map("to_state")
  actorType String   @map("actor_type")
  actorId   String?  @map("actor_id")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt(sort: Desc)])
  @@map("order_events")
}

// ─── ANALYTICS ───────────────────────────────────────────────────────────────

model DailyStoreMetrics {
  date    DateTime @db.Date
  storeId String   @map("store_id")
  revenue Decimal  @default(0) @db.Decimal(12, 2)
  cost    Decimal  @default(0) @db.Decimal(12, 2)
  profit  Decimal  @default(0) @db.Decimal(12, 2)
  orders  Int      @default(0)
  aov     Decimal  @default(0) @db.Decimal(10, 2)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([date, storeId])
  @@index([storeId])
  @@map("daily_store_metrics")
}

model DailyProductMetrics {
  date      DateTime @db.Date
  storeId   String   @map("store_id")
  productId String   @map("product_id")
  unitsSold Int      @default(0) @map("units_sold")
  revenue   Decimal  @default(0) @db.Decimal(12, 2)
  cost      Decimal  @default(0) @db.Decimal(12, 2)
  profit    Decimal  @default(0) @db.Decimal(12, 2)
  orders    Int      @default(0)

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([date, storeId, productId])
  @@index([storeId])
  @@map("daily_product_metrics")
}

// ─── AI ──────────────────────────────────────────────────────────────────────

model AISession {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  userId    String   @map("user_id")
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store    Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]
  actions  AIAction[]

  @@index([storeId])
  @@map("ai_sessions")
}

model AIMessage {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  role      String
  content   String?
  toolCalls Json?    @map("tool_calls")
  toolName  String?  @map("tool_name")
  createdAt DateTime @default(now()) @map("created_at")

  session AISession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("ai_messages")
}

model AIAction {
  id               String    @id @default(uuid())
  storeId          String    @map("store_id")
  sessionId        String?   @map("session_id")
  toolName         String    @map("tool_name")
  riskLevel        String    @map("risk_level")
  input            Json
  output           Json?
  status           String    @default("proposed")
  requiresApproval Boolean   @default(false) @map("requires_approval")
  impactGrade      String    @default("low") @map("impact_grade")
  escalatedAt      DateTime? @map("escalated_at")
  approvedBy       String?   @map("approved_by")
  approvedAt       DateTime? @map("approved_at")
  executedAt       DateTime? @map("executed_at")
  error            String?
  createdAt        DateTime  @default(now()) @map("created_at")

  store   Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  session AISession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@map("ai_actions")
}

model AIInsight {
  id          String    @id @default(uuid())
  storeId     String    @map("store_id")
  type        String
  severity    String
  title       String
  description String?
  data        Json?
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@map("ai_insights")
}

model AuditLog {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  actorType   String   @map("actor_type")
  actorId     String?  @map("actor_id")
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("audit_log")
}

// ─── DISCOUNTS ───────────────────────────────────────────────────────────────

model DiscountCode {
  id             String    @id @default(uuid())
  storeId        String    @map("store_id")
  code           String    // stored trim + uppercase, A-Z 0-9 _ -
  type           String    // "percentage" | "fixed"
  // percentage → e.g. 10.00 = 10% ; fixed → e.g. 15.00 = 15 RON
  value          Decimal   @db.Decimal(10, 2)
  currency       String    @db.VarChar(3)              // snapshot at creation
  minOrderAmount Decimal?  @db.Decimal(10, 2) @map("min_order_amount")
  maxUses        Int?      @map("max_uses")
  usedCount      Int       @default(0) @map("used_count")
  startsAt       DateTime? @map("starts_at")
  expiresAt      DateTime? @map("expires_at")
  isActive       Boolean   @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  store        Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reservations DiscountReservation[]
  orders       Order[]

  @@index([storeId, deletedAt])
  @@map("discount_codes")
}

model DiscountReservation {
  id              String    @id @default(uuid())
  discountCodeId  String    @map("discount_code_id")
  storeId         String    @map("store_id")
  stripeSessionId String?   @unique @map("stripe_session_id")
  amount          Decimal   @db.Decimal(10, 2)          // calculated discount, same units as Order.discountTotal
  status          String    @default("reserved")        // "reserved" | "consumed" | "released"
  createdAt       DateTime  @default(now()) @map("created_at")
  resolvedAt      DateTime? @map("resolved_at")

  discountCode DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("discount_reservations")
}

model ProcessedStripeEvent {
  eventId     String   @id @map("event_id")
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_stripe_events")
}

// ─── CATALOG ─────────────────────────────────────────────────────────────────

model CatalogCategory {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  parentId String? @map("parent_id")

  parent   CatalogCategory?  @relation("CatalogCategoryTree", fields: [parentId], references: [id])
  children CatalogCategory[] @relation("CatalogCategoryTree")
  products CatalogProduct[]

  @@map("catalog_categories")
}

model CatalogProduct {
  id          String   @id @default(cuid())
  title       String
  description String?
  categoryId  String?  @map("category_id")
  productType String?  @map("product_type")
  status      String   @default("pending")
  aiGenerated Boolean  @default(false) @map("ai_generated")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category      CatalogCategory? @relation(fields: [categoryId], references: [id])
  variants      CatalogVariant[]
  storeProducts StoreProduct[]
  requests      ProductRequest[]

  @@index([status])
  @@index([categoryId])
  @@map("catalog_products")
}

model CatalogVariant {
  id               String   @id @default(cuid())
  catalogProductId String   @map("catalog_product_id")
  title            String
  sku              String
  suggestedPrice   Decimal  @db.Decimal(10, 2) @map("suggested_price")
  createdAt        DateTime @default(now()) @map("created_at")

  catalogProduct       CatalogProduct        @relation(fields: [catalogProductId], references: [id])
  storeProductVariants StoreProductVariant[]
  images               CatalogVariantImage[]

  @@map("catalog_variants")
}

model CatalogVariantImage {
  id              String   @id @default(uuid())
  catalogVariantId String  @map("catalog_variant_id")
  url             String
  altText         String?  @map("alt_text")
  position        Int      @default(0)
  isPrimary       Boolean  @default(false) @map("is_primary")
  createdAt       DateTime @default(now()) @map("created_at")

  catalogVariant CatalogVariant @relation(fields: [catalogVariantId], references: [id], onDelete: Cascade)

  @@index([catalogVariantId])
  @@index([catalogVariantId, isPrimary])
  @@map("catalog_variant_images")
}

model StoreProduct {
  id               String   @id @default(cuid())
  storeId          String   @map("store_id")
  catalogProductId String   @map("catalog_product_id")
  addedAt          DateTime @default(now()) @map("added_at")
  shippingCost     Decimal  @default(0) @db.Decimal(10, 2) @map("shipping_cost")

  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  catalogProduct CatalogProduct @relation(fields: [catalogProductId], references: [id])
  variants       StoreProductVariant[]

  @@unique([storeId, catalogProductId])
  @@index([storeId])
  @@map("store_products")
}

model StoreProductVariant {
  id               String   @id @default(cuid())
  storeProductId   String   @map("store_product_id")
  catalogVariantId String   @map("catalog_variant_id")
  customPrice      Decimal? @db.Decimal(10, 2) @map("custom_price")
  isActive         Boolean  @default(true) @map("is_active")

  storeProduct   StoreProduct   @relation(fields: [storeProductId], references: [id], onDelete: Cascade)
  catalogVariant CatalogVariant @relation(fields: [catalogVariantId], references: [id])
  stock          StoreVariantStock?

  @@unique([storeProductId, catalogVariantId])
  @@map("store_product_variants")
}

model StoreVariantStock {
  id                    String   @id @default(cuid())
  storeId               String   @map("store_id")
  storeProductVariantId String   @unique @map("store_product_variant_id")
  quantity              Int      @default(0)
  heldQuantity          Int      @default(0) @map("held_quantity")
  lastMovementType      String?  @map("last_movement_type")
  note                  String?
  updatedAt             DateTime @updatedAt @map("updated_at")
  createdAt             DateTime @default(now()) @map("created_at")

  store               Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeProductVariant StoreProductVariant @relation(fields: [storeProductVariantId], references: [id], onDelete: Cascade)

  @@map("store_variant_stock")
}

model ProductRequest {
  id               String   @id @default(cuid())
  storeId          String   @map("store_id")
  requestedTitle   String   @map("requested_title")
  description      String?
  category         String?
  status           String   @default("pending")
  rejectionReason  String?  @map("rejection_reason")
  catalogProductId String?  @map("catalog_product_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  catalogProduct CatalogProduct? @relation(fields: [catalogProductId], references: [id])

  @@index([storeId, status])
  @@map("product_requests")
}

model AIToolCriteria {
  id           String    @id @default(cuid())
  toolName     String    @map("tool_name")
  followUpText String    @map("follow_up_text")
  addedBy      String    @map("added_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  @@index([toolName])
  @@map("ai_tool_criteria")
}

model ArchiveCriteria {
  id          String   @id @default(cuid())
  name        String
  criteriaKey String   @unique @map("criteria_key")
  value       String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("archive_criteria")
}

// ─── STOREFRONT THEME ────────────────────────────────────────────────────────

model ThemeVersion {
  id             String   @id @default(uuid())
  storeId        String   @map("store_id")
  schemaVersion  Int      @default(1) @map("schema_version")
  config         Json
  status         String   @default("draft")
  createdBy      String   @map("created_by")
  label          String?
  hasA11yWarning Boolean  @default(false) @map("has_a11y_warning")
  createdAt      DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@map("theme_versions")
}

// ─── NOTIFICATIONS ───────────────────────────────────────────────────────────

enum NotificationType {
  ORDER_NEW
  ORDER_CANCELLED
  REFUND_REQUESTED
  REFUND_PROCESSED
  STOCK_LOW
  STOCK_OUT
  STOCK_IN
  STOCK_REMOVAL
  STOCK_ADJUSTMENT
  PAYMENT_FAILED
  CHARGEBACK_OPENED
  AI_ACTION
  SYSTEM_WEBHOOK_FAILED
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model Notification {
  id        String               @id @default(cuid())
  storeId   String               @map("store_id")
  type      NotificationType
  severity  NotificationSeverity
  title     String
  message   String
  metadata  Json?
  readAt    DateTime?            @map("read_at")
  createdAt DateTime             @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt(sort: Desc)])
  @@index([storeId, readAt])
  @@map("notifications")
}

// ─── SHIPPING ────────────────────────────────────────────────────────────────

model ShippingMethod {
  id              String   @id @default(uuid())
  storeId         String   @map("store_id")
  name            String
  description     String?
  price           Decimal  @default(0) @db.Decimal(10, 2)
  isFree          Boolean  @default(false) @map("is_free")
  minOrderForFree Decimal? @db.Decimal(10, 2) @map("min_order_for_free")
  countries       String[] @default([])
  isActive        Boolean  @default(true) @map("is_active")
  position        Int      @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, isActive])
  @@index([storeId, position])
  @@map("shipping_methods")
}
