generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stores        Store[]
  refreshTokens RefreshToken[]
  aiSessions    AISession[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ─── STORE ───────────────────────────────────────────────────────────────────

model Store {
  id        String   @id @default(uuid())
  ownerId   String   @map("owner_id")
  name      String
  slug      String   @unique
  currency  String   @default("EUR")
  locale    String   @default("en")
  timezone  String   @default("Europe/Bucharest")
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner               User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  categories          ProductCategory[]
  products            Product[]
  customers           Customer[]
  orders              Order[]
  inventoryItems      InventoryItem[]
  inventoryMovements  InventoryMovement[]
  dailyStoreMetrics   DailyStoreMetrics[]
  dailyProductMetrics DailyProductMetrics[]
  aiSessions          AISession[]
  aiActions           AIAction[]
  aiInsights          AIInsight[]
  auditLogs           AuditLog[]

  @@index([ownerId])
  @@map("stores")
}

// ─── PRODUCTS ────────────────────────────────────────────────────────────────

model ProductCategory {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  name      String
  slug      String
  createdAt DateTime @default(now()) @map("created_at")

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([storeId, slug])
  @@map("product_categories")
}

model Product {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  categoryId  String?  @map("category_id")
  title       String
  description String?
  status      String   @default("draft")
  productType String?  @map("product_type")
  vendor      String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store               Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category            ProductCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants            ProductVariant[]
  dailyProductMetrics DailyProductMetrics[]

  @@index([storeId])
  @@index([storeId, status])
  @@map("products")
}

model ProductVariant {
  id             String   @id @default(uuid())
  productId      String   @map("product_id")
  sku            String
  title          String
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2) @map("compare_at_price")
  cost           Decimal? @db.Decimal(10, 2)
  weight         Decimal? @db.Decimal(10, 3)
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryItem      InventoryItem?
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]

  @@unique([productId, sku])
  @@index([productId])
  @@map("product_variants")
}

// ─── INVENTORY ───────────────────────────────────────────────────────────────

model InventoryItem {
  id               String   @id @default(uuid())
  variantId        String   @unique @map("variant_id")
  storeId          String   @map("store_id")
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  reorderPoint     Int      @default(0) @map("reorder_point")
  updatedAt        DateTime @updatedAt @map("updated_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("inventory_items")
}

model InventoryMovement {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  variantId String   @map("variant_id")
  type      String
  quantity  Int
  note      String?
  actorType String   @default("user") @map("actor_type")
  createdAt DateTime @default(now()) @map("created_at")

  store   Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId])
  @@map("inventory_movements")
}

// ─── CUSTOMERS & ORDERS ──────────────────────────────────────────────────────

model Customer {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  email     String
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store  Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([storeId, email])
  @@map("customers")
}

model Order {
  id                String   @id @default(uuid())
  storeId           String   @map("store_id")
  customerId        String?  @map("customer_id")
  orderNumber       Int      @default(autoincrement()) @map("order_number")
  status            String   @default("pending")
  paymentStatus     String   @default("pending") @map("payment_status")
  fulfillmentStatus String   @default("unfulfilled") @map("fulfillment_status")
  currency          String
  subtotal          Decimal  @db.Decimal(10, 2)
  discountTotal     Decimal  @default(0) @db.Decimal(10, 2) @map("discount_total")
  taxTotal          Decimal  @default(0) @db.Decimal(10, 2) @map("tax_total")
  shippingTotal     Decimal  @default(0) @db.Decimal(10, 2) @map("shipping_total")
  total             Decimal  @db.Decimal(10, 2)
  shippingAddress   Json?    @map("shipping_address")
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  store    Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    OrderItem[]

  @@index([storeId])
  @@index([storeId, fulfillmentStatus])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  variantId String?  @map("variant_id")
  title     String
  sku       String?
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2) @map("unit_price")
  total     Decimal  @db.Decimal(10, 2)

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("order_items")
}

// ─── ANALYTICS ───────────────────────────────────────────────────────────────

model DailyStoreMetrics {
  date    DateTime @db.Date
  storeId String   @map("store_id")
  revenue Decimal  @default(0) @db.Decimal(12, 2)
  cost    Decimal  @default(0) @db.Decimal(12, 2)
  profit  Decimal  @default(0) @db.Decimal(12, 2)
  orders  Int      @default(0)
  aov     Decimal  @default(0) @db.Decimal(10, 2)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([date, storeId])
  @@index([storeId])
  @@map("daily_store_metrics")
}

model DailyProductMetrics {
  date      DateTime @db.Date
  storeId   String   @map("store_id")
  productId String   @map("product_id")
  unitsSold Int      @default(0) @map("units_sold")
  revenue   Decimal  @default(0) @db.Decimal(12, 2)
  cost      Decimal  @default(0) @db.Decimal(12, 2)
  profit    Decimal  @default(0) @db.Decimal(12, 2)
  orders    Int      @default(0)

  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([date, storeId, productId])
  @@index([storeId])
  @@map("daily_product_metrics")
}

// ─── AI ──────────────────────────────────────────────────────────────────────

model AISession {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  userId    String   @map("user_id")
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store    Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AIMessage[]
  actions  AIAction[]

  @@index([storeId])
  @@map("ai_sessions")
}

model AIMessage {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  role      String
  content   String?
  toolCalls Json?    @map("tool_calls")
  toolName  String?  @map("tool_name")
  createdAt DateTime @default(now()) @map("created_at")

  session AISession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("ai_messages")
}

model AIAction {
  id               String    @id @default(uuid())
  storeId          String    @map("store_id")
  sessionId        String?   @map("session_id")
  toolName         String    @map("tool_name")
  riskLevel        String    @map("risk_level")
  input            Json
  output           Json?
  status           String    @default("proposed")
  requiresApproval Boolean   @default(false) @map("requires_approval")
  approvedBy       String?   @map("approved_by")
  approvedAt       DateTime? @map("approved_at")
  executedAt       DateTime? @map("executed_at")
  error            String?
  createdAt        DateTime  @default(now()) @map("created_at")

  store   Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  session AISession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@map("ai_actions")
}

model AIInsight {
  id          String    @id @default(uuid())
  storeId     String    @map("store_id")
  type        String
  severity    String
  title       String
  description String?
  data        Json?
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@map("ai_insights")
}

model AuditLog {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  actorType   String   @map("actor_type")
  actorId     String?  @map("actor_id")
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  beforeState Json?    @map("before_state")
  afterState  Json?    @map("after_state")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("audit_log")
}
